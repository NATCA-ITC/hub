# ============================================
# MyNATCA Hub - Environment Configuration
# ============================================

# Auth0 Configuration (CRITICAL: Use SAME Auth0 app as Platform)
# Shared authentication ensures cross-platform logout sync
VITE_AUTH0_DOMAIN=natca-dev.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_platform_auth0_client_id
VITE_AUTH0_AUDIENCE=https://mynatca.org/api

# Supabase Configuration
# For production, use your hosted Supabase project
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Platform API Configuration
# Hub communicates with Platform backend for shared data
VITE_PLATFORM_API_URL=http://localhost:1300

# Rackspace Infrastructure Monitoring
# For production server monitoring and alerts
VITE_RACKSPACE_API_ENDPOINT=your_rackspace_api_endpoint
VITE_RACKSPACE_REGION=your_rackspace_region
VITE_RACKSPACE_AUTH_TOKEN=your_rackspace_token

# AI Chat Service Configuration
# For conversation storage and AI response generation
VITE_AI_SERVICE_ENABLED=true
VITE_CONVERSATION_RETENTION_DAYS=14

# Application Metadata
VITE_APP_TITLE=MyNATCA Hub
VITE_APP_DESCRIPTION=Member portal for MyNATCA platform
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=warn